# Copy to apps/docs/.env.local for the local documentation preview.
# No service credentials are needed. Public assets still require internet access.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_LOCAL_PREVIEW=true
NEXT_PUBLIC_CDN_URL=https://heroui-assets.nyc3.cdn.digitaloceanspaces.com
NEXT_PUBLIC_SHOW_PRE_SALE_BANNER=false
# The local preview launcher derives this from RAIN_STORYBOOK_PORT.
NEXT_PUBLIC_RAIN_STORYBOOK_URL=http://127.0.0.1:6006
